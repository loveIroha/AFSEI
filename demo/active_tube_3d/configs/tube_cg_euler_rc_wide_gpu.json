{
  "demo": "active-tube-3d",
  "description": "Collar-supported CG-CN/Euler RC tube with actual circumferential stretch feedback to Land; unchanged MAC spacing and loading scale",
  "geometry": {
    "length_cm": 2.0,
    "inner_radius_cm": 0.3,
    "wall_thickness_cm": 0.1,
    "center_xy_cm": [
      0.7,
      0.7
    ],
    "axial_start_cm": 0.4,
    "axial_elements": 40,
    "circumferential_elements": 32,
    "thickness_elements": 2
  },
  "fluid": {
    "shape": [
      64,
      64,
      56
    ],
    "lengths_cm": [
      2.8,
      2.8,
      2.8
    ],
    "origin_cm": [
      -0.7,
      -0.7,
      0.0
    ],
    "density_g_per_cm3": 1.035,
    "viscosity_dyn_s_per_cm2": 0.08,
    "boundary": "zero-reference-pressure-with-rc-box-outlet"
  },
  "solid": {
    "young_modulus_dyn_cm2": 300000.0,
    "poisson_ratio": 0.3,
    "end_condition": "full-reference-surface-spring-approximation",
    "end_spring_dyn_cm3": 1000000.0,
    "collar_support": {
      "width_cm": 0.1,
      "stiffness_dyn_cm4": 10000000000.0
    }
  },
  "active": {
    "mechanism": "circumferential-land-pk1",
    "rest_reference": "land-equilibrium-increment",
    "tension_scale": 1.0,
    "end_taper_cm": 0.15,
    "minimum_radius_ratio": 0.2,
    "stretch_feedback": "circumferential"
  },
  "ep": {
    "conductivity_direction": "axial-z",
    "boundary": "insulating-all-wall-surfaces",
    "parameters": {
      "capacitance_uf_per_cm2": 1.0,
      "surface_to_volume_per_cm": 0.1,
      "conductivity_us_per_cm": [
        0.117,
        0.039,
        0.039
      ]
    },
    "numerics": {
      "discretization": "consistent_p1",
      "backend": "torch_pcg_jacobi_light",
      "time_scheme": "crank_nicolson",
      "solver": {
        "rtol": 1E-10,
        "atol": 1E-13,
        "max_iterations": 500,
        "check_every": 5
      },
      "diffusion_quadrature": "consistent_p1"
    },
    "ode_method": "explicit_euler"
  },
  "stimulus": {
    "start_s": 0.005,
    "duration_s": 0.002,
    "width_cm": 0.1,
    "amplitude_ua_per_cm2": 35.714285714285715
  },
  "time": {
    "fsi_dt_s": 5E-05,
    "ep_dt_s": 5E-05,
    "ode_dt_ms": 0.001,
    "end_time_s": 0.8
  },
  "fsi": {
    "spatial_coupling": "griffith-luo-2017-unified",
    "time_scheme": "be-be",
    "execution": {
      "execution_backend": "fused",
      "pressure_backend": "graph",
      "mass_backend": "graph",
      "warm_start": true
    },
    "flow": {
      "convection": true,
      "helmholtz_backend": "graph",
      "helmholtz_rtol": 1E-12,
      "helmholtz_atol": 1E-13,
      "max_sweeps": 500,
      "check_every": 4
    },
    "pressure_solver": {
      "rtol": 1E-10,
      "atol": 1E-11,
      "max_cycles": 100,
      "smooth": 4,
      "check_every": 2
    },
    "mass_solver": {
      "rtol": 1E-11,
      "atol": 1E-12,
      "max_iterations": 500,
      "check_every": 4
    },
    "interaction_quadrature": {
      "mode": "adaptive",
      "point_density": 2.0,
      "max_order": 12,
      "max_points": 12000000,
      "rule_family": "xiao-gimbutas",
      "transfer_backend": "fused",
      "stencil_backend": "shared",
      "prepare_backend": "triton",
      "reuse_stencil_buffers": true
    },
    "nonlinear_solver": "newton",
    "nonlinear": {
      "rtol": 1E-06,
      "atol": 1E-09,
      "max_iterations": 15,
      "linear_tolerance_fraction": 0.05,
      "linear": {
        "rtol": 0.001,
        "atol": 1E-11,
        "restart": 40,
        "max_iterations": 240,
        "check_every": 5
      }
    },
    "max_courant": 1.0
  },
  "output": {
    "log_every": 100,
    "field_every": 40,
    "checkpoint_every": 400,
    "write_vtk": true
  },
  "circulation": {
    "model": "sharifi-2021-rc",
    "resistance_mmhg_s_per_mm3": 60.0,
    "compliance_mm3_per_mmhg": 0.26,
    "initial_pressure_mmhg": 0.0,
    "outlet_scope": "z-high-full-box-face"
  },
  "hydraulic_domain": {
    "kind": "sealed-end-reservoirs",
    "aperture_margin_cells": 0.25,
    "collar_cells": 2,
    "pressure_max_iterations": 200
  }
}
