{
  "demo": "active-tube-2d",
  "geometry": {
    "length_cm": 2.4, "lumen_height_cm": 0.6, "wall_thickness_cm": 0.1,
    "inlet_buffer_cm": 0.4, "center_y_cm": 0.8,
    "axial_elements": 48, "thickness_elements": 2
  },
  "fluid": {
    "shape": [64, 32], "lengths_cm": [3.2, 1.6],
    "density_g_per_cm3": 1.025, "viscosity_dyn_s_per_cm2": 0.04,
    "end_boundary": "pressure-neumann-velocity", "outer_y_boundary": "no-slip",
    "inlet_pressure_dyn_per_cm2": 200.0, "outlet_pressure_dyn_per_cm2": 0.0
  },
  "solid": {"shear_modulus": 100000.0, "lame_lambda": 200000.0, "end_spring": 1000000.0},
  "active": {"mechanism": "paired-hoop-land", "rest_reference": "land-equilibrium-increment", "tension_scale": 1.0, "end_taper_cm": 0.1},
  "ep": {
    "parameters": {"capacitance_uf_per_cm2": 1.0, "surface_to_volume_per_cm": 0.1,
                   "conductivity_us_per_cm": [0.117, 0.039, 0.039]},
    "numerics": {"discretization": "nodal_p1", "backend": "torch_pcg_jacobi_light",
                 "time_scheme": "crank_nicolson", "solver": {"rtol": 1e-10, "atol": 1e-13, "max_iterations": 500}}
  },
  "stimulus": {"start_s": 0.01, "duration_s": 0.002, "width_cm": 0.1, "amplitude_ua_per_cm2": 35.714285714285715},
  "time": {"fsi_dt_s": 0.00005, "ep_dt_s": 0.00005, "ode_dt_ms": 0.002, "end_time_s": 0.1},
  "solver": {
    "pressure_backend": "graph", "mass_backend": "graph", "ib_backend": "cuda",
    "pressure": {"rtol": 1e-10, "atol": 1e-11, "max_cycles": 100, "smooth": 4, "check_every": 2},
    "mass": {"rtol": 1e-11, "atol": 1e-12, "max_iterations": 500, "check_every": 4}
  },
  "output": {"log_every": 100, "field_every": 200}
}
